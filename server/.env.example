# Server Configuration
PORT=5000
NODE_ENV=development
JWT_SECRET=freedomain-super-secret-jwt-key-change-in-prod-2026

# MySQL Database Configuration (Optional: defaults to auto-embedded SQLite if unconfigured)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=freedomain_db

# Initial Admin Credentials
ADMIN_EMAIL=admin@freedomain.org
ADMIN_PASSWORD=Admin@12345

# Registrar API Configuration
# Options: 'resellerclub' | 'porkbun'
REGISTRAR_PROVIDER=resellerclub
REGISTRAR_SANDBOX=true

# ResellerClub / LogicBoxes Credentials (Optional - sandbox simulated when empty)
RESELLERCLUB_USER_ID=
RESELLERCLUB_API_KEY=

# Porkbun Credentials (Optional)
PORKBUN_API_KEY=
PORKBUN_SECRET_KEY=
